{
  "name": "ui.byronwade.com",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:experience": "node scripts/check-experience.mjs",
    "check:meridian": "node scripts/meridian-check.mjs",
    "check:platform": "node scripts/check-platform.mjs",
    "check:proofs": "node scripts/check-proofs.mjs",
    "check:routes": "node scripts/check-routes.mjs",
    "check:shell": "node scripts/check-shell.mjs",
    "check:typeset": "node scripts/check-typeset.mjs",
    "dev": "next dev",
    "format": "biome format --write .",
    "gen:contract": "node scripts/gen-contract.mjs",
    "lint": "eslint",
    "lint:biome": "biome lint .",
    "mcp:contract": "node packages/contract-mcp/server.mjs",
    "mcp:meridian": "CONTRACT_ID=meridian node packages/contract-mcp/server.mjs",
    "scan": "npm run scan:dead && npm run scan:react && npm run scan:ui",
    "scan:cost": "npx --yes vercel-doctor@latest",
    "scan:dead": "knip",
    "scan:react": "npx --yes react-doctor@latest",
    "scan:renders": "echo 'react-scan runs as a dev overlay: npm run dev, then watch the on-page render report' ",
    "scan:ui": "npx --yes @shadscan/cli@latest",
    "start": "next start",
    "validate": "npm run check:platform && npm run check:routes && npm run check:design && npm run check:shell && npm run check:proofs && npm run check:typeset && npm run check:experience && npm run check:contrast && npm run lint"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "geist": "^1.7.2",
    "next": "16.2.12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "knip": "^6.32.0",
    "playwright": "^1.62.1",
    "react-scan": "^0.5.7",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
