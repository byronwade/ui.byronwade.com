{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!.next",
      "!node_modules",
      "!public/r",
      "!components/ui"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": { "semicolons": "asNeeded", "quoteStyle": "double" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": { "noNonNullAssertion": "off" },
      "suspicious": { "noArrayIndexKey": "off" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "off" } } }
}
